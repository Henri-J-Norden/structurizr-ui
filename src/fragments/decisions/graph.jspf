<div class="modal" id="graphModal" tabindex="-1" role="dialog" aria-labelledby="informationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div id="graphContent" class="modal-body">
                <%@ include file="/WEB-INF/fragments/tooltip.jspf" %>
                <div class="centered">
                    <div id="exploreGraph" style="width: 100%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script nonce="${scriptNonce}">
    var node, link;
    var linkedById = {};
    var allDecisionsByScopeAndId = {};
    var width, height;
    var simulation;

    function buildAllDecisionsByScopeAndId() {
        allDecisionsByScopeAndId = {};

        function addDecisionsForElement(element, scope) {
            if (element && element.documentation && element.documentation.decisions) {
                element.documentation.decisions.forEach(function(decision) {
                    allDecisionsByScopeAndId[scope + '/' + decision.id] = {
                        decision: decision,
                        scope: scope
                    };
                });
            }
        }

        if (structurizr.workspace.model && structurizr.workspace.model.softwareSystems) {
            structurizr.workspace.model.softwareSystems.forEach(function(softwareSystem) {
                var softwareSystemScope = toScope(softwareSystem);
                addDecisionsForElement(softwareSystem, softwareSystemScope);

                if (softwareSystem.containers) {
                    softwareSystem.containers.forEach(function(container) {
                        var containerScope = toScope(container);
                        addDecisionsForElement(container, containerScope);

                        if (container.components) {
                            container.components.forEach(function(component) {
                                addDecisionsForElement(component, toScope(component));
                            });
                        }
                    });
                }
            });
        }
    }

    function neighboring(a, b) {
        return linkedById[a.id + "," + b.id] !== undefined;
    }

    function resetGraph() {
        node.style("stroke-width", "2px");
        node.style("opacity", '1');
        link.style("opacity", '1');
    }

    function showConnectedNodes(nodeClicked, reset) {
        var d = d3.select(nodeClicked).node().__data__;
        if (d.decision === undefined) {
            resetGraph();

            return;
        }

        if (reset === true) {
            resetGraph();
        }

        $(nodeClicked).css("stroke-width", "4px");

        function getNodeId(scope, decisionId) {
            return scope + '/' + decisionId;
        }

        function getTargetNodeId(link, sourceScope) {
            return (link.scope ? link.scope : sourceScope) + '/' + link.id;
        }

        var hasMore = true;
        var network = [];
        network.push(d.id);

        while (hasMore) {
            hasMore = false;

            Object.keys(allDecisionsByScopeAndId).forEach(function(sourceNodeId) {
                var decisionWithScope = allDecisionsByScopeAndId[sourceNodeId];
                var decision = decisionWithScope.decision;
                var sourceScope = decisionWithScope.scope;

                if (decision.links) {
                    decision.links.forEach(function(link) {
                        var targetNodeId = getTargetNodeId(link, sourceScope);

                        if (network.indexOf(sourceNodeId) > -1 && network.indexOf(targetNodeId) === -1) {
                            network.push(targetNodeId);
                            hasMore = true;
                        }

                        if (network.indexOf(targetNodeId) > -1 && network.indexOf(sourceNodeId) === -1) {
                            network.push(sourceNodeId);
                            hasMore = true;
                        }
                    });
                }
            });
        }

        node.style("opacity", function(o) {
            var currentOpacity = d3.select(this).style('opacity');
            return network.indexOf(o.id) > -1 ? 1 : (reset === true ? 0.1 : currentOpacity);
        });

        link.style("opacity", function(o) {
            var currentOpacity = d3.select(this).style('opacity');
            return (network.indexOf(o.source.id) > -1 || network.indexOf(o.target.id) > -1) ? 1 : (reset === true ? 0.1 : currentOpacity);
        });
    }

    function click(event, d) {
        showConnectedNodes(this, true);

        if (d.decision) {
            if (d.scope === requestedScope) {
                window.location.hash = '#' + d.decision.id;
            } else {
                window.location.href = '<c:out value="${urlPrefix}" />/decisions/' + encodeURI(d.scope) + '<c:out value="${urlSuffix}" escapeXml="false" />#' + d.decision.id;
            }
        }
    }

    function dblclick(event, d) {
        if (d.decision) {
            if (d.scope === requestedScope) {
                window.location.hash = '#' + d.decision.id;
            } else {
                window.location.href = '<c:out value="${urlPrefix}" />/decisions/' + encodeURI(d.scope) + '<c:out value="${urlSuffix}" escapeXml="false" />#' + d.decision.id;
            }
            $('#graphModal').modal('hide');
        }
    }

    function renderGraph() {
        $("#exploreGraph").empty();

        try {
            var svg = d3.select("#exploreGraph").append("svg")
                .attr("width", width)
                .attr("height", height)
                .append("g");

            svg.append("svg:defs").selectAll("marker")
                .data(["arrowStraight"])
                .enter().append("svg:marker")
                .attr("id", String)
                .attr("viewBox", "0 0 14 14")
                .attr("refX", 35)
                .attr("refY", 6)
                .attr("markerWidth", 12)
                .attr("markerHeight", 12)
                .attr("orient", "auto")
                .append("svg:path")
                .attr("d", "M0,0 L12,6 L0,12 L0,0")
                .attr("fill", '#dddddd');

            var distance = Math.min(width, height) / 3;

            simulation = d3.forceSimulation(graph.nodes)
                .force("link", d3.forceLink().distance(distance).id(function (d) {
                    return d.id;
                }))
                .force("charge", d3.forceManyBody().strength(-distance))
                .force("center", d3.forceCenter(width / 2, height / 2))
                .stop();

            link = svg.selectAll(".link")
                .data(graph.links)
                .enter()
                .append("svg:path")
                .attr("class", "link")
                .attr("stroke", function (d) {
                    return d.source === 'root' ? undefined : '#dddddd';
                })
                .attr("marker-end", function(d) {
                    return d.source === 'root' ? undefined : 'url(#arrowStraight)';
                })
                .on("mouseover", showTooltipForLink)
                .on("mousemove", moveTooltip)
                .on("mouseout", hideTooltip);

            node = svg.selectAll(".node")
                .data(graph.nodes)
                .enter()
                .append("g")
                .attr("class", "node")
                .call(d3.drag()
                    .on("start", dragstarted)
                    .on("drag", dragged)
                    .on("end", dragended)
                )
                .on("click", click)
                .on("dblclick", dblclick)
                .on("mouseover", showTooltipForDecision)
                .on("mousemove", moveTooltip)
                .on("mouseout", hideTooltip);

            node.append("circle")
                .attr("id", function (d) {
                    return 'decision' + d.id.replace(/\//g, '-');
                })
                .attr("r", '20')
                .style("fill", function (d) {
                    if (d.status) {
                        return getDecisionStyle(d).background;
                    } else {
                        return '#777777';
                    }
                })
                .style("stroke", function (d) {
                    var color;
                    if (d.status) {
                        color = getDecisionStyle(d).background;
                    } else {
                        color = '#777777';
                    }

                    return structurizr.util.shadeColor(color, -20);
                })
                .classed("external", function (d) {
                    return d.scope && d.scope !== requestedScope;
                });

            node.append("text")
                .attr("class", "nodeName")
                .attr("dy", function (d) {
                    return 0;
                })
                .attr("dx", function (d) {
                    return 25;
                })
                .text(function (d) {
                    return d.name;
                });

            node.append("text")
                .attr("class", "nodeMetadata")
                .attr("dy", function(d) {
                    return 10;
                })
                .attr("dx", function(d) {
                    return 25;
                })
                .text(function (d) { return d.status ; });

            simulation.nodes(graph.nodes).on("tick", ticked);

            simulation.force("link").links(graph.links);

            simulation.alphaTarget(0.9);

            for (var i = 0; i < 300; ++i) {
                simulation.tick();
            }

            simulation.alphaTarget(0).restart();

            function ticked() {
                link.attr("d", function (d) {
                    if (isLinked(d.source.id, d.target.id) && isLinked(d.target.id, d.source.id)) {
                        // bi-directional relationship
                        var dx = d.target.x - d.source.x,
                            dy = d.target.y - d.source.y,
                            dr = Math.sqrt(dx * dx + dy * dy) * 2;
                        return "M" +
                            d.source.x + "," +
                            d.source.y + "A" +
                            dr + "," + dr + " 0 0,1 " +
                            d.target.x + "," +
                            d.target.y;
                    } else {
                        // uni-directional relationship
                        return "M" + d.source.x + "," + d.source.y + " " + "L" + d.target.x + "," + d.target.y;
                    }

                });

                node.attr("transform", function (d) {
                    return "translate(" + Math.max(0, Math.min(width, d.x)) + "," + Math.max(0, Math.min(height, d.y)) + ")";
                });
            }
        } catch (err) {
            console.log(err);
        }
    }

    function calculateSize(d) {
        return 20;
    }

    function dragstarted(event, d) {
        if (!event.active) {
            simulation.alphaTarget(0.3).restart();
        }
        d.fx = d.x;
        d.fy = d.y;
    }

    function dragged(event, d) {
        d.fx = event.x;
        d.fy = event.y;
    }

    function dragended(event, d) {
        if (!event.active) {
            simulation.alphaTarget(0);
        }
        d.fx = null;
        d.fy = null;
    }

    function createGraph() {
        if (decisions === undefined || decisions.length === 0) {
            return undefined;
        }

        buildAllDecisionsByScopeAndId();

        $('#graphButton').removeClass('hidden');

        function getNodeId(scope, decisionId) {
            return scope + '/' + decisionId;
        }

        function addNode(nodeId, name, description, status, decision, scope) {
            if (nodesById[nodeId] === undefined) {
                graph.nodes.push({
                    id: nodeId,
                    name: name,
                    description: description,
                    status: status,
                    decision: decision,
                    scope: scope
                });
                nodesById[nodeId] = true;
            }
        }

        function addRootEdge(nodeId) {
            if (!isLinked('root', nodeId)) {
                registerLink('root', nodeId);
                graph.links.push({
                    id: 'root-' + nodeId,
                    source: 'root',
                    target: nodeId,
                    description: ''
                });
            }
        }

        function addEdge(sourceNodeId, targetNodeId, description) {
            if (!isLinked(sourceNodeId, targetNodeId)) {
                registerLink(sourceNodeId, targetNodeId);
                graph.links.push({
                    id: sourceNodeId + '-' + targetNodeId,
                    source: sourceNodeId,
                    target: targetNodeId,
                    description: description
                });
            }
        }

        var rootNodeName = 'Decisions';
        var graph = { nodes: [
                {
                    id: 'root',
                    name: rootNodeName,
                    description: '',
                    status: undefined,
                    decision: undefined,
                    scope: undefined
                }
            ], links: []};
        var nodesById = {};

        // First pass: add current-scope nodes and all outgoing edges
        decisions.forEach(function(decision) {
            var nodeId = getNodeId(requestedScope, decision.id);

            addNode(nodeId, decision.title, decision.description, decision.status, decision, requestedScope);
            addRootEdge(nodeId);
            if (!isLinked(nodeId, nodeId)) {
                registerLink(nodeId, nodeId); // this prevents the nodes in the graph linking to themselves
            }

            if (decision.links) {
                decision.links.forEach(function(link) {
                    var targetScope = link.scope ? link.scope : requestedScope;
                    var targetNodeId = getNodeId(targetScope, link.id);
                    var targetDecisionWithScope = allDecisionsByScopeAndId[targetNodeId];

                    if (targetDecisionWithScope !== undefined) {
                        var targetDecision = targetDecisionWithScope.decision;
                        var targetScopeName = targetDecisionWithScope.scope;
                        addNode(targetNodeId, targetDecision.title, targetDecision.description, targetDecision.status, targetDecision, targetScopeName);
                        addRootEdge(targetNodeId);
                        addEdge(nodeId, targetNodeId, link.description);
                    }
                });
            }
        });

        // Second pass: add incoming edges from other scopes
        Object.keys(allDecisionsByScopeAndId).forEach(function(sourceNodeId) {
            var decisionWithScope = allDecisionsByScopeAndId[sourceNodeId];
            if (decisionWithScope.scope === requestedScope) {
                // already handled in first pass
                return;
            }

            var decision = decisionWithScope.decision;
            if (decision.links) {
                decision.links.forEach(function(link) {
                    var targetScope = link.scope ? link.scope : decisionWithScope.scope;
                    var targetNodeId = getNodeId(targetScope, link.id);

                    // if this external decision links into the current scope, add the source and the edge
                    if (targetScope === requestedScope && nodesById[targetNodeId] !== undefined) {
                        addNode(sourceNodeId, decision.title, decision.description, decision.status, decision, decisionWithScope.scope);
                        addRootEdge(sourceNodeId);
                        addEdge(sourceNodeId, targetNodeId, link.description);
                    }
                });
            }
        });

        return graph;
    }

    function highlightDecisionInGraph(decision) {
        if (node !== undefined) {
            highlightNode(requestedScope + '/' + decision.id);
        }
    }

    function highlightNode(id) {
        node.filter(function (d) {
            return d.decision !== undefined && d.id === id;
        }).nodes().forEach(function (d, i) {
            showConnectedNodes(d, true);
        });
    }

    function isLinked(sourceId, destinationId) {
        return linkedById[sourceId + "," + destinationId] !== undefined;
    }

    function registerLink(sourceId, destinationId) {
        linkedById[sourceId + "," + destinationId] = 1;
    }

    function showTooltipForDecision(event, d) {
        if (d.id === 'root') {
            return;
        }

        var decision = d.decision;
        var style = getDecisionStyle(d);
        var title = decision.id + '. ' + decision.title;
        if (d.scope && d.scope !== requestedScope) {
            title = d.scope + ' / ' + title;
        }
        tooltip.showTooltip(title, '', '[' + decision.status + ']', style.background, style.color);
    }

    function showTooltipForLink(event, d) {
        if (d.description) {
            const summary = d.source.name + ' - ' + d.description + ' - ' + d.target.name;
            tooltip.showTooltip(d.description, summary, '', '#ffffff', '#000000');
        }
    }

    function moveTooltip(event) {
        tooltip.reposition(event.pageX, event.pageY);
    }

    function hideTooltip(event) {
        tooltip.hide();
    }

    function setWidthAndHeight() {
        width = window.innerWidth * 0.90;
        height = window.innerHeight * 0.90;
    }

    function resizeGraph() {
        setWidthAndHeight();
        $("#exploreGraph svg").attr('width', width);
        $("#exploreGraph svg").attr('height', height);

        simulation.force("center")
            .x(width / 2)
            .y(height / 2);

        simulation.alpha(0.3).restart();
    }

    function openGraphModal() {
        if (graph !== undefined) {
            $('#graphModal').modal('show');
        }
    }

    $('#graphModal').on('shown.bs.modal', function (e) {
        resizeGraph();
    });
</script>
